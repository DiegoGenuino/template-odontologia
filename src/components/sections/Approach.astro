---
import type { SiteConfig } from "../../config/site";
interface Props { data: SiteConfig["approach"] }
const { data } = Astro.props;
---
<section class="approach" aria-labelledby="approach-title">
  <div class="wrap approach-inner">
    <h2 id="approach-title">
      <span class="approach-line"><span class="approach-line-text">{data.firstLine}</span></span>
      <span class="approach-line approach-line-muted"><img src={data.inlineImage.src} alt={data.inlineImage.alt} width={data.inlineImage.width} height={data.inlineImage.height} loading="lazy" decoding="async" /><span class="approach-line-text">{data.secondLine}</span></span>
    </h2>
    <div class="approach-grid" style={`--approach-columns:${Math.max(1, Math.min(data.items.length, 3))}`}>
      {data.items.map((item) => (
        <article class="approach-item">
          <span class="approach-number">{item.number}</span>
          <div class="approach-detail"><h3>{item.title}</h3><p>{item.description}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>
