---
import { resolveHref } from "../config/site";
interface Props {
  label: string;
  href?: string;
  className?: string;
  type?: "button" | "submit" | "reset";
}
const { label, href, className = "", type = "button" } = Astro.props;
const Tag = href ? "a" : "button";
---
<Tag class:list={[className, "cta-standard"]} href={href ? resolveHref(href) : undefined} type={href ? undefined : type}>
  {label} <span class="cta-arrow" aria-hidden="true"><svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6 18L18 6M18 6H10M18 6V14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
</Tag>
