---
import { resolveHref, type SiteConfig } from "../config/site";
interface Props { item: SiteConfig["services"]["items"][number] }
const { item } = Astro.props;
---
<article class="service-card" style={`background:${item.background}`}>
  <span class="service-icon" aria-hidden="true" style={`color:${item.iconColor}`}>
    <svg viewBox="0 0 48 48">{item.iconPaths.map((path) => <path d={path} />)}</svg>
  </span>
  <h3>{item.title}</h3>
  <p>{item.description}</p>
  <a class="service-more" href={resolveHref(item.href)} aria-label={item.linkLabel}>
    <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6 18L18 6M18 6H10M18 6V14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </a>
</article>
